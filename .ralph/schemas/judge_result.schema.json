{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "must_fix",
    "warnings",
    "ignored",
    "policy_blocks"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FIX_REQUIRED",
        "BLOCKED"
      ]
    },
    "must_fix": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ignored": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "policy_blocks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
