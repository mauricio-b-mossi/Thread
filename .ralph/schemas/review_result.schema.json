{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "reviewer",
    "status",
    "findings",
    "summary"
  ],
  "properties": {
    "reviewer": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "FAIL"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "file",
          "issue",
          "why_it_matters",
          "suggested_fix"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "BLOCKER",
              "WARNING",
              "NIT"
            ]
          },
          "file": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
