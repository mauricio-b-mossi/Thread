{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "task_id",
    "summary",
    "files_changed",
    "tests_run",
    "discovered_tasks"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "DONE",
        "BLOCKED",
        "NEEDS_HUMAN"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discovered_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "description",
          "proposal_type"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          },
          "proposal_type": {
            "type": "string",
            "enum": [
              "blocking",
              "backlog"
            ]
          },
          "risk_level": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
